        },
        {
          "class": "DepictionLabelView",
          "text": "Adds the fifth number row Apple still hasn't brought to the iPhone after all these years.",
          "fontWeight": "normal",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "Features:",
          "fontWeight": "bold",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "Adds an extra row that feels at home on the stock keyboard. Press Shift or 123 and it becomes the punctuation you actually use — no more doubled number row.",
          "fontWeight": "normal",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "Rename the ABC and 123 keys, up to five characters each.",
          "fontWeight": "normal",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "Supports Latin keyboards and many non-Latin layouts. Available layouts may vary by iOS version.",
          "fontWeight": "normal",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "Turn the tweak on or off, exclude individual apps, and reset everything to defaults in one tap.",
          "fontWeight": "normal",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "Pro adds:",
          "fontWeight": "bold",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "All ten keys on both rows, which row appears in each situation, keyboard height, and the always-five-rows switch.",
          "fontWeight": "normal",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "Notes:",
          "fontWeight": "bold",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "iPhone only. Portrait keyboards only. Handwriting and third-party keyboards are not supported.",
          "fontWeight": "normal",
          "usePadding": true
        },
        {
          "class": "DepictionLabelView",
          "text": "If something goes wrong, turn on the diagnostic log in Settings, reproduce the problem, then copy the log and email it to asdlkjlkjasd@gmail.com.",
          "fontWeight": "normal",
          "usePadding": true
        },
